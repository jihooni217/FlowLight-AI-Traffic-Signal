# Copy this file to .env and fill in your key. Never commit .env.
UPSTAGE_API_KEY=

# Solar chat model alias or snapshot. Default is solar-pro4.
# Use solar-pro3 to roll back, or solar-pro4-260806 to pin a snapshot.
UPSTAGE_MODEL=solar-pro4

# Output format. json_schema (default) = structured outputs, fields/types/enums enforced by the API.
# Set to json_object to fall back to plain JSON mode if a schema-related error ever appears.
UPSTAGE_OUTPUT_MODE=json_schema
